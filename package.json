{
  "name": "magickisa-avg-webgame-engine",
  "version": "2.0.0-dev.2",
  "private": true,
  "type": "module",
  "scripts": {
    "magickisa": "node scripts/magickisa.mjs",
    "test:cli": "node scripts/cli-test.mjs",
    "test:launcher": "node scripts/launcher-test.mjs",
    "package:release": "node scripts/package-release.mjs",
    "notices:update": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "dev": "vite --host 127.0.0.1 --open /engine.html",
    "build": "tsc --noEmit && vite build",
    "build:studio": "node scripts/build-studio.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:studio": "node scripts/studio-test.mjs",
    "content:build": "tsx scripts/content.ts build",
    "content:validate": "tsx scripts/content.ts validate",
    "test:authoring": "node scripts/authoring-test.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.56.0",
    "playwright-core": "^1.56.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "license": "MIT",
  "description": "MAGICKISA AVG web game engine and visual authoring Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kisara-Lab/Magickisa-AVG-WEBGAME-ENGINE.git"
  },
  "engines": {
    "node": ">=22"
  }
}
